# Maintainer: Michael Otto <michael@astrapi.de>
pkgname=homepage
pkgver=2.2.0
pkgrel=2
pkgdesc="A highly customizable homepage (or startpage) with Docker and service API integrations"
# Nur amd64: der Debian-Builder baut auf einem einzelnen Host ohne
# Cross-Arch-Toolchain, und unten wird ein konkretes linux-x64-Node.js
# geladen. Ausserdem kann build_index.py mehrwertige arch=(...)-Arrays
# nicht sauber parsen (siehe T-001-DEBIAN) -- ein einzelner Wert
# vermeidet das von vornherein.
arch=('amd64')
distribution=trixie
url="https://gethomepage.dev"
license=('GPL-3.0-only')
depends=('nodejs (>= 20.9)')
optdepends=('docker: für Docker-Service-Discovery (User "homepage" muss der Gruppe "docker" beitreten, siehe homepage.service)')
source=()

_sha256="c0d76213975f94555467a5db1fab3e2b6f35b5bdb1ef4b6a6e32e9b194f6e9cd"
_tarball="${pkgname}-${pkgver}.tar.gz"
_url="https://github.com/gethomepage/homepage/archive/refs/tags/v${pkgver}.tar.gz"

# Node.js + pnpm sind im Debian-Builder-Image nicht vorinstalliert (nur
# build-essential/devscripts/debhelper/git/curl/fakeroot) und lassen sich
# dort mangels sudo/root auch nicht per apt-get nachruesten.
#
# Node.js kommt deshalb als .deb aus dem internen NodeSource-Mirror
# (https://mirror.simpsons.lan/files/debian/node24x/) -- kein
# echtes "apt-get install" (dafuer fehlt Root), stattdessen wird das
# .deb per curl geladen, gegen den SHA256 aus dessen eigenem
# Packages-Index geprueft und mit `dpkg-deb -x` ausgepackt (reine
# Dateientnahme, kein Registrieren in dpkg noetig). Das
# TLS-Zertifikat von mirror.simpsons.lan ist intern signiert -- curl
# braucht hier -k, genau wie apt in debian-builder.dockerfile
# (Acquire::https::Verify-Peer "false" fuer denselben Host).
#
# Version + SHA256 werden bewusst NICHT hier gepinnt, sondern erst in
# build() zur Laufzeit aufgeloest: der Mirror haelt im Pool immer nur die
# jeweils aktuellste NodeSource-Version vor, aeltere Dateien werden
# geloescht (nicht nur aus dem Index entfernt) -- ein fester Pin brach
# dadurch bei jedem Node-Update im Mirror mit 404 (siehe T-024-DEBIAN).
_nodepool="https://mirror.simpsons.lan/files/debian/node24x/pool/main/n/nodejs/"
_nodeindex="https://mirror.simpsons.lan/files/debian/node24x/dists/nodistro/main/binary-amd64/Packages.gz"

# pnpm gibt es (Stand jetzt) nicht im internen Mirror -- Standalone-Binary
# weiterhin direkt vom GitHub-Release, wie grml-zsh-config/
# vaultwarden-web-vault es fuer ihre Downloads bereits tun.
_pnpmver="9.15.9"
_pnpm_sha256="38949c3009bd674780ca7d652baa9e2310f5cda07ab9160b0e2a9c4934ab0def"
_pnpm_url="https://github.com/pnpm/pnpm/releases/download/v${_pnpmver}/pnpm-linux-x64"

build() {
    # Aktuell im Mirror-Pool vorhandene nodejs-.deb ermitteln (dort liegt
    # immer nur eine einzige Datei) und ihren SHA256 aus dem zugehoerigen
    # Packages-Index nachschlagen -- siehe Kommentar oben.
    local _nodedeb
    _nodedeb=$(curl -fsSLk "${_nodepool}" | grep -oE 'nodejs_[0-9][^"]*_amd64\.deb' | head -n1)
    [ -n "${_nodedeb}" ] || { echo "Kein nodejs-.deb im Mirror-Pool gefunden: ${_nodepool}" >&2; exit 1; }

    local _nodedeb_sha256
    _nodedeb_sha256=$(curl -fsSLk "${_nodeindex}" | gunzip -c | awk -v f="pool/main/n/nodejs/${_nodedeb}" '
        $0 == "Filename: " f { hit=1 }
        hit && /^SHA256: / { print $2; exit }
    ')
    [ -n "${_nodedeb_sha256}" ] || { echo "Kein SHA256 fuer ${_nodedeb} im Packages-Index gefunden" >&2; exit 1; }

    curl -fsSLk --retry 3 --retry-delay 2 -o "${_nodedeb}" "${_nodepool}${_nodedeb}"
    echo "${_nodedeb_sha256}  ${_nodedeb}" | sha256sum -c -
    mkdir -p node-deb
    dpkg-deb -x "${_nodedeb}" node-deb

    curl -fSL --retry 3 --retry-delay 2 -o pnpm "${_pnpm_url}"
    echo "${_pnpm_sha256}  pnpm" | sha256sum -c -
    chmod +x pnpm

    export PATH="${srcdir}/node-deb/usr/bin:${srcdir}:${PATH}"

    curl -fSL --retry 3 --retry-delay 2 -o "${_tarball}" "${_url}"
    echo "${_sha256}  ${_tarball}" | sha256sum -c -
    tar -xzf "${_tarball}"

    cd "${srcdir}/${pkgname}-${pkgver}"
    NEXT_TELEMETRY_DISABLED=1 pnpm install --frozen-lockfile
    NEXT_TELEMETRY_DISABLED=1 pnpm run build
}

package() {
    # Voller srcdir-Pfad statt eines relativen "cd ${pkgname}-${pkgver}":
    # package() laeuft in einer eigenen fakeroot-Subshell und darf sich
    # nicht auf das cd aus build() verlassen.
    cd "${srcdir}/${pkgname}-${pkgver}"

    # Next.js-Standalone-Output installieren. Enthaelt server.js + eine
    # eigene .next/-Kopie, aber bewusst NICHT die statischen Assets und
    # nicht public/ -- die muss man laut Next.js-Doku separat dazukopieren
    # (fehlte in der urspruenglichen PKGBUILD komplett, siehe T-002-DEBIAN:
    # ohne .next/static waeren alle CSS/JS-Assets per 404 kaputt gewesen,
    # ohne public/ hätten Favicons/Icons gefehlt).
    install -d "${pkgdir}/usr/share/webapps/${pkgname}"
    cp -r .next/standalone/. "${pkgdir}/usr/share/webapps/${pkgname}/"

    install -d "${pkgdir}/usr/share/webapps/${pkgname}/.next/static"
    cp -r .next/static/. "${pkgdir}/usr/share/webapps/${pkgname}/.next/static/"

    cp -r public "${pkgdir}/usr/share/webapps/${pkgname}/public"

    install -Dm644 "${srcdir}/homepage.service" "${pkgdir}/usr/lib/systemd/system/homepage.service"
    install -Dm644 "${srcdir}/homepage.conf" "${pkgdir}/etc/conf.d/homepage"
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

    install -d "${pkgdir}/usr/bin"
    ln -s "/usr/share/webapps/${pkgname}/server.js" "${pkgdir}/usr/bin/homepage"

    # Dedizierter System-User + Config-/Datenverzeichnis (der systemd-Unit
    # verlangt User=homepage, ohne postinst gaebe es den nie).
    install -d "${pkgdir}/DEBIAN"
    cat > "${pkgdir}/DEBIAN/postinst" << 'EOF'
#!/bin/sh
set -e
if ! getent passwd homepage >/dev/null; then
    adduser --system --group --no-create-home --home /var/lib/homepage \
        --shell /usr/sbin/nologin homepage
fi
install -d -o homepage -g homepage /etc/homepage
install -d -o homepage -g homepage /var/lib/homepage
EOF
    chmod 755 "${pkgdir}/DEBIAN/postinst"

    cat > "${pkgdir}/DEBIAN/postrm" << 'EOF'
#!/bin/sh
set -e
if [ "$1" = "purge" ]; then
    deluser --system homepage >/dev/null 2>&1 || true
    rm -rf /var/lib/homepage
fi
EOF
    chmod 755 "${pkgdir}/DEBIAN/postrm"
}

# vim:set ts=2 sw=2 et:
