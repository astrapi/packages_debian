# Maintainer: Michael Otto <michael@astrapi.de>
#
# Braucht Rust >= 1.95.0 (vaultwardens eigene rust-version-Vorgabe in
# Cargo.toml, Stand 1.37.1) -- Debian trixie liefert nur 1.85.0, trixie-
# backports 1.94.1 aber mit einer grossen Kette an System-Bibliotheks-
# Abhaengigkeiten (libgit2, libcurl4t64, libllvm21, ...). Statt das im
# PKGBUILD zu vendoren (wie Node.js/pnpm bei homepage), baut dieses Paket
# deshalb mit dem dedizierten Image "ctl/debian-builder-rust" (Basis:
# offizielles rust:1.95.0-slim-trixie, siehe astrapi-packages/.../debian/
# dockerfiles/debian-builder-rust.dockerfile) statt dem Standard-
# "ctl/debian-builder". cargo/rustc kommen von dort bereits fertig mit.
#
# pkgver 1.36.0 -> 1.37.1: vaultwarden 1.36.0 hat einen serverseitigen
# Serialisierungsfehler im /api/sync-Cipher-"data"-Feld, der mit dem
# strikten WASM-SDK neuerer offizieller Bitwarden-Clients (Browser/
# Desktop/Mobile ab ca. 2026.4.x) kollidiert ("Unexpected JSON token ...
# Expected beginning of the string, but got {" bzw. "invalid type:
# JsValue(Object(...)), expected a string") -- Web-Vault (aelterer JS-SDK)
# bleibt davon unberuehrt, daher unauffaellig dort. Behoben in vaultwarden
# 1.37.0 (PR dani-garcia/vaultwarden#7434, das fehlerhafte Feld existiert
# danach nicht mehr). MSRV bleibt bei genau 1.95.0, Image passt weiterhin.
pkgname=vaultwarden
pkgver=1.37.2
pkgrel=1
pkgdesc="An alternative Bitwarden server API implementation written in Rust"
# Nur amd64: siehe homepage/PKGBUILD -- build_index.py kann ohnehin nur
# einwertige arch=(...)-Arrays sauber parsen (T-001-DEBIAN).
arch=('amd64')
distribution=trixie
depends=('libssl3t64' 'libsqlite3-0' 'vaultwarden-web-vault') # Erzwingt dein Web-Vault Paket
makedepends=('cargo' 'rustc' 'pkg-config' 'libssl-dev' 'libsqlite3-dev')
source=()

_sha256="32c43436517fe67bdf207cf9e803a3b71e87703f384604588d360f7e6724f045"
_tarball="${pkgname}-${pkgver}.tar.gz"
_url="https://github.com/dani-garcia/vaultwarden/archive/refs/tags/${pkgver}.tar.gz"

build() {
    curl -fSL --retry 3 --retry-delay 2 -o "${_tarball}" "${_url}"
    echo "${_sha256}  ${_tarball}" | sha256sum -c -
    tar -xzf "${_tarball}"

    cd "${srcdir}/${pkgname}-${pkgver}"
    cargo build --features sqlite --release
}

package() {
    # Voller srcdir-Pfad statt eines relativen "cd ${pkgname}-${pkgver}":
    # package() laeuft in einer eigenen fakeroot-Subshell und darf sich
    # nicht auf das cd aus build() verlassen (siehe homepage/PKGBUILD).
    cd "${srcdir}/${pkgname}-${pkgver}"

    install -Dm755 "target/release/vaultwarden" "${pkgdir}/usr/bin/vaultwarden"

    install -Dm640 /dev/null "${pkgdir}/etc/vaultwarden.env"
    cat <<EOF > "${pkgdir}/etc/vaultwarden.env"
# Vaultwarden Konfiguration für Debian
#
# DATA_FOLDER zeigt bewusst auf einen "data"-Unterordner (nicht direkt
# auf /var/lib/vaultwarden) -- das ist Vaultwardens eigener Default
# (relativ zum Working Directory) und die Konvention, mit der auch
# andere gaengige Debian-Pakete dieses Projekts (z.B. das von
# dionysius) die Daten ablegen. Wichtig fuer Hosts, auf denen vorher
# schon mal ein anderes vaultwarden-Debian-Paket lief: dessen Vault
# liegt mit hoher Wahrscheinlichkeit ebenfalls unter .../data und wird
# so automatisch weiterverwendet statt eine neue, leere DB anzulegen.
DATA_FOLDER=/var/lib/vaultwarden/data
WEB_VAULT_FOLDER=/usr/share/vaultwarden/web-vault
WEB_VAULT_ENABLED=true
ROCKET_ADDRESS=127.0.0.1
ROCKET_PORT=8000
EOF

    install -Dm644 /dev/null "${pkgdir}/usr/lib/systemd/system/vaultwarden.service"
    cat <<EOF > "${pkgdir}/usr/lib/systemd/system/vaultwarden.service"
[Unit]
Description=Vaultwarden Server (Bitwarden compatible)
Documentation=https://github.com/dani-garcia/vaultwarden
After=network.target

[Service]
User=vaultwarden
Group=vaultwarden
EnvironmentFile=/etc/vaultwarden.env
ExecStart=/usr/bin/vaultwarden
Restart=on-failure
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/vaultwarden

[Install]
WantedBy=multi-user.target
EOF

    # Dedizierter System-User + Datenverzeichnis (die systemd-Unit
    # verlangt User=vaultwarden, ohne postinst gaebe es den nie) --
    # gleiches Muster wie homepage/PKGBUILD.
    install -d "${pkgdir}/DEBIAN"
    cat > "${pkgdir}/DEBIAN/postinst" << 'EOF'
#!/bin/sh
set -e
if ! getent passwd vaultwarden >/dev/null; then
    adduser --system --group --no-create-home --home /var/lib/vaultwarden \
        --shell /usr/sbin/nologin vaultwarden
fi
install -d -o vaultwarden -g vaultwarden /var/lib/vaultwarden
install -d -o vaultwarden -g vaultwarden /var/lib/vaultwarden/data
EOF
    chmod 755 "${pkgdir}/DEBIAN/postinst"

    cat > "${pkgdir}/DEBIAN/postrm" << 'EOF'
#!/bin/sh
set -e
if [ "$1" = "purge" ]; then
    deluser --system vaultwarden >/dev/null 2>&1 || true
    rm -rf /var/lib/vaultwarden
fi
EOF
    chmod 755 "${pkgdir}/DEBIAN/postrm"
}
