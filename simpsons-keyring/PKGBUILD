# Maintainer: astrapi <astrapi@example.com>
pkgname=simpsons-keyring
pkgver=1.0.0
pkgrel=2
pkgdesc="Simpsons CA-Zertifikat und APT-Signierschlüssel für interne Dienste"
arch=('all')
distribution=trixie
depends=('ca-certificates')
makedepends=()
source=('simpsons-ca.crt' 'simpsons-packages.asc')

package() {
    # Prüfen ob das CA-Zertifikat vorhanden und kein Platzhalter ist
    if ! grep -q "BEGIN CERTIFICATE" simpsons-ca.crt 2>/dev/null; then
        echo "FEHLER: simpsons-ca.crt fehlt oder ist kein gültiges PEM-Zertifikat."
        echo ""
        echo "OPNsense → System → Trust → Authorities → eigene CA → Export (PEM)"
        echo "Datei als 'simpsons-ca.crt' neben diesem PKGBUILD ablegen."
        exit 1
    fi

    # CA-Zertifikat installieren
    install -dm755 "$pkgdir/usr/local/share/ca-certificates"
    install -m644 simpsons-ca.crt "$pkgdir/usr/local/share/ca-certificates/simpsons-ca.crt"

    # APT-Signierschlüssel installieren (falls vorhanden)
    if grep -q "BEGIN PGP PUBLIC KEY BLOCK" simpsons-packages.asc 2>/dev/null; then
        install -dm755 "$pkgdir/usr/share/keyrings"
        gpg --dearmor < simpsons-packages.asc > "$pkgdir/usr/share/keyrings/simpsons-packages.gpg"
        chmod 644 "$pkgdir/usr/share/keyrings/simpsons-packages.gpg"
    fi

    # postinst: Zertifikat-Datenbank nach Installation aktualisieren
    cat > "$pkgdir/DEBIAN/postinst" << 'EOF'
#!/bin/sh
set -e
update-ca-certificates
EOF
    chmod 755 "$pkgdir/DEBIAN/postinst"

    # postrm: Zertifikat-Datenbank nach Deinstallation aktualisieren
    cat > "$pkgdir/DEBIAN/postrm" << 'EOF'
#!/bin/sh
set -e
update-ca-certificates
EOF
    chmod 755 "$pkgdir/DEBIAN/postrm"
}
