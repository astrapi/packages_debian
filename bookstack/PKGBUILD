# Maintainer: Michael Otto <michael@astrapi.de>
#
# Kein GitHub-Release-Asset vorhanden -- Quelle ist der automatisch von
# GitHub erzeugte Tag-Sourcecode-Tarball. Anders als bei paperless-ngx wird
# hier NICHT extra ein npm/Node-Frontend-Build gebraucht: BookStack
# committet seine gebauten Frontend-Assets (public/dist/*.js/*.css) direkt
# ins Repo, die offizielle Bare-Metal-Doku erwaehnt entsprechend nur
# "git clone" + "composer install", kein npm. Siehe E-004.
#
# Braucht ein dediziertes Docker-Image (ctl/debian-builder-php statt
# ctl/debian-builder, siehe E-004): composer.json verlangt PHP >= 8.2 und
# mehrere ext-*-Erweiterungen, die im Standard-Image nicht vorinstalliert
# sind. Debian trixies php 8.4 erfuellt die Versionsvorgabe ohne Weiteres,
# kein exotisches Basis-Image wie bei vaultwarden/Rust noetig.
#
# Abweichung von E-004 (mod_php statt FPM, /opt statt /var/www, www-data
# statt eigenem User): auf wiki.simpsons.lan lief bereits eine bare-metal
# BookStack-Installation genau in dieser Konfiguration (fertiger
# Apache-vhost mit TLS, mod_php, /opt/bookstack, www-data:www-data). Das
# Paket wurde bewusst an dieses bestehende Setup angeglichen statt
# umgekehrt den laufenden vhost umzubauen, um die Migration auf einen
# reinen Datei-/DB-Wechsel zu reduzieren. Siehe E-007.
#
# .env ist als DEBIAN/conffiles-Eintrag markiert: bei der Erstinstallation
# dieses Pakets ueber eine bereits vorhandene manuelle Installation
# (Migrationsfall) laesst dpkg eine bereits vorhandene, nicht von dpkg
# verwaltete Datei an einer Conffile-Position unangetastet -- die echte
# .env mit den bestehenden DB-Zugangsdaten/APP_KEY wird dadurch NICHT
# durch den Platzhalter-Inhalt unten ueberschrieben. Nur bei einer
# wirklich frischen Installation (keine Datei vorhanden) greift der
# Platzhalter, der postinst-Trigger fuer key:generate bleibt darauf
# abgestimmt.
pkgname=bookstack
pkgver=26.05.3
pkgrel=2
pkgdesc="BookStack is a simple, self-hosted, easy-to-use platform for organising and storing information (wiki)"
arch=('amd64')
distribution=trixie
url="https://www.bookstackapp.com"
license=('MIT')
depends=(
    'apache2'
    'libapache2-mod-php8.4'
    'php8.4-cli'
    'php8.4-curl'
    'php8.4-xml'
    'php8.4-mbstring'
    'php8.4-gd'
    'php8.4-zip'
    'php8.4-mysql'
    'mariadb-server'
)
# Dokumentarisch -- jobs.py wertet makedepends nicht aus, kommen fest aus
# ctl/debian-builder-php (siehe E-004).
makedepends=('php8.4-cli' 'composer' 'git')
source=()

_sha256="0cceef9fa56ea68b5717b1afee890472dd949ddedbe7c285305a65dc2fb06079"
_tarball="bookstack-v${pkgver}.tar.gz"
_url="https://github.com/BookStackApp/BookStack/archive/refs/tags/v${pkgver}.tar.gz"

build() {
    curl -fSL --retry 3 --retry-delay 2 -o "${_tarball}" "${_url}"
    echo "${_sha256}  ${_tarball}" | sha256sum -c -
    tar -xzf "${_tarball}"

    cd "${srcdir}/BookStack-${pkgver}"
    # --no-dev: keine Test-/Dev-Abhaengigkeiten (phpunit, phpstan, ...) im
    # ausgelieferten Paket. Laravels "post-autoload-dump"-Hook ruft dabei
    # "artisan package:discover" auf -- das braucht keine bereits
    # vorhandene .env/DB-Verbindung, env()-Aufrufe fallen mangels .env auf
    # ihre Config-Defaults zurueck.
    COMPOSER_ALLOW_SUPERUSER=1 composer install \
        --no-dev --no-interaction --optimize-autoloader --no-progress
}

package() {
    # Voller srcdir-Pfad statt eines relativen "cd": package() laeuft in
    # einer eigenen fakeroot-Subshell und darf sich nicht auf das cd aus
    # build() verlassen (siehe homepage/vaultwarden/paperless-ngx PKGBUILD).
    cd "${srcdir}/BookStack-${pkgver}"

    # /opt/bookstack statt /var/www/<pkgname> (Abweichung von E-004, siehe
    # Kommentar am Dateianfang): entspricht der bereits auf wiki.simpsons.lan
    # laufenden bare-metal-Installation, deren Apache-vhost DocumentRoot
    # fest auf /opt/bookstack/public zeigt.
    install -d "${pkgdir}/opt/bookstack"
    cp -r . "${pkgdir}/opt/bookstack/"
    rm -rf "${pkgdir}/opt/bookstack/.git" "${pkgdir}/opt/bookstack/tests"

    # App-Baum bleibt root-owned im .deb (wie beim FPM-Original) --
    # www-data braucht dafuer nur Lesbarkeit, keine Ownership. Der eigentliche
    # chown auf www-data fuer die schreibbaren Verzeichnisse (storage,
    # bootstrap/cache, public/uploads, .env) passiert unten in postinst mit
    # echtem Root auf dem Zielsystem -- ein chown hier in package() waere
    # wirkungslos: build.sh startet fuer package() und fuer das
    # anschliessende "dpkg-deb --build" zwei getrennte fakeroot-Sessions,
    # eine hier gefakte Ownership geht beim Sessionwechsel verloren und
    # landet nicht im .deb (beim Testbau verifiziert: Ergebnis war
    # durchgehend root:root trotz chown -R hier).
    #
    # Echte .env-Datei statt /etc/*.conf: Laravel/BookStack erwartet laut
    # eigener Doku ausdruecklich eine .env im App-Wurzelverzeichnis. Als
    # Conffile markiert (siehe DEBIAN/conffiles unten) -- wichtig fuer den
    # Migrationsfall (siehe Kommentar am Dateianfang).
    rm -f "${pkgdir}/opt/bookstack/.env"
    install -Dm640 /dev/null "${pkgdir}/opt/bookstack/.env"
    cat <<'EOF' > "${pkgdir}/opt/bookstack/.env"
# BookStack Konfiguration fuer Debian
# Volle Optionsliste: .env.example.complete im App-Verzeichnis

APP_ENV=production
APP_DEBUG=false
# Wird von postinst automatisch generiert (php artisan key:generate),
# solange hier noch "SomeRandomString" steht.
APP_KEY=SomeRandomString
APP_URL=http://localhost

DB_HOST=localhost
DB_DATABASE=bookstack
DB_USERNAME=bookstack
DB_PASSWORD=change-me

MAIL_DRIVER=smtp
MAIL_FROM_NAME="BookStack"
MAIL_FROM=bookstack@example.com
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
EOF

    install -d "${pkgdir}/DEBIAN"

    # .env als Conffile: laesst dpkg eine bei der Erstinstallation bereits
    # vorhandene, nicht von dpkg verwaltete Datei an dieser Position
    # unangetastet (siehe Kommentar am Dateianfang) -- kritisch fuer die
    # Migration von der bare-metal-Installation, deren echte .env sonst
    # durch den Platzhalter oben ueberschrieben wuerde.
    echo "/opt/bookstack/.env" > "${pkgdir}/DEBIAN/conffiles"

    cat > "${pkgdir}/DEBIAN/postinst" << 'EOF'
#!/bin/sh
set -e
chown -R www-data:www-data /opt/bookstack/storage
chown -R www-data:www-data /opt/bookstack/bootstrap/cache
chown -R www-data:www-data /opt/bookstack/public/uploads

chown www-data:www-data /opt/bookstack/.env
chmod 640 /opt/bookstack/.env

if grep -q '^APP_KEY=SomeRandomString$' /opt/bookstack/.env; then
    php8.4 /opt/bookstack/artisan key:generate --force --ansi
fi

a2enmod php8.4 2>/dev/null || true
systemctl reload apache2 2>/dev/null || true

cat <<'MSG'
BookStack installiert, aber noch nicht startklar:
  1. Falls dies eine frische Installation ist (keine bestehende .env
     uebernommen): /opt/bookstack/.env ausfuellen (mindestens
     DB_PASSWORD, APP_URL)
  2. MariaDB-Rolle + Datenbank anlegen (Name/User/Passwort aus .env),
     falls noch nicht vorhanden
  3. Erstes Migrate:
     sudo -u www-data php8.4 /opt/bookstack/artisan migrate --force
  4. Apache-vhost selbst einrichten/pruefen: DocumentRoot auf
     /opt/bookstack/public (Paket richtet bewusst keinen vhost ein)
  5. Falls von v25.x aktualisiert: storage/fonts-Rechte pruefen
     (PDF-Export, seit v26.05 geaendert) und SMTP-Versand testen
     (Einstellungen > Wartung > Test-E-Mail senden)
MSG
EOF
    chmod 755 "${pkgdir}/DEBIAN/postinst"

    cat > "${pkgdir}/DEBIAN/postrm" << 'EOF'
#!/bin/sh
set -e
if [ "$1" = "purge" ]; then
    rm -rf /opt/bookstack/storage/app /opt/bookstack/storage/backups \
        /opt/bookstack/storage/uploads /opt/bookstack/public/uploads
fi
EOF
    chmod 755 "${pkgdir}/DEBIAN/postrm"
}

# vim:set ts=2 sw=2 et:
