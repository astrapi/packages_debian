# Maintainer: Michael Otto <michael@astrapi.de>
#
# CLI-Client + geteilte Sync-Engine fuer astrapi-sync, portiert aus dem
# gleichnamigen packages_archlinux-Paket. Baut vom main-HEAD des
# Monorepos astrapi-sync-linux (kein PyPI-Release) -- source_url zeigt
# wie ueberall in diesem Repo auf packages_debian.git selbst, das
# eigentliche Upstream-Repo wird in build() manuell geklont (kein
# "source=()"-Aequivalent fuer Git-Quellen in dieser Pipeline, die
# klont nur source_url selbst nach /build/src).
#
# pkgver ist statisch -- kein pkgver()-Aequivalent wie bei makepkg
# unterstuetzt (_build_cmd() in astrapi_packages/modules/debian/jobs.py
# liest nur die deklarierte Zeile), muss bei neuen astrapi-sync-linux-
# Tags manuell nachgezogen werden, analog zum Arch-Pendant.
pkgname=astrapi-sync-cli
pkgver=26.8.2
pkgrel=1
pkgdesc="CLI-Client + geteilte Sync-Engine fuer astrapi-sync (Ordner-Synchronisation ueber mehrere eigene Geraete)"
arch=('all')
distribution=trixie
depends=('python3' 'python3-httpx' 'python3-websockets' 'python3-watchdog')
makedepends=()
source=()

# python3-venv (bringt pip via ensurepip mit -- kein System-pip im
# Basis-Image) ist im custom Builder-Image vorinstalliert, siehe
# astrapi_packages/modules/debian/dockerfiles/debian-builder-python.dockerfile
# (urspruenglich fuer paperless-ngx angelegt, hier wiederverwendet).
# sync_builder_image_from_pkgbuild() vergleicht diesen Wert gegen das
# *Label* des registrierten Images (= die blosse Image-ID), nicht gegen
# den vollen "ctl/<id>"-Namen -- "ctl/debian-builder-python" matchte nie
# (still ignoriert, nur Log-Warnung). Am astrapi-admin-agent-Bau entdeckt
# (Build lief mit dem Default-Image ohne python3-venv). Nur die bloße ID:
_builder_image=debian-builder-python
_repo_url="https://github.com/astrapi/astrapi-sync-linux.git"

build() {
    git clone --quiet "${_repo_url}" upstream
    cd upstream/astrapi-sync-cli

    # python3-build/-installer/-wheel sind kein System-Paket im Builder-
    # Image -- ueber ein Wegwerf-venv installiert, nur fuer diesen
    # Bau-Schritt (das fertige Paket haengt zur Laufzeit ausschliesslich
    # von den oben deklarierten depends= ab, nicht vom venv).
    python3 -m venv /tmp/build-venv
    /tmp/build-venv/bin/pip install --quiet build installer wheel setuptools
    /tmp/build-venv/bin/python -m build --wheel --no-isolation
}

package() {
    # ANDERS als der Kommentar in anderen PKGBUILDs dieses Repos vermuten
    # laesst: package() erbt das Arbeitsverzeichnis, in dem build() endete
    # (die Pipeline setzt zwischen den Schritten kein "cd zurueck zu
    # srcdir"), es startet NICHT bei srcdir selbst. Ein relatives
    # "cd upstream/astrapi-sync-cli" waere hier doppelt verschachtelt
    # (build() ist selbst schon dorthin gewechselt) -- deshalb absoluter
    # Pfad ueber srcdir, empirisch am echten Server-Bau als Fehlerursache
    # bestaetigt ("cd: upstream/astrapi-sync-cli: No such file or
    # directory").
    cd "${srcdir}/upstream/astrapi-sync-cli"

    # "python -m installer" schreibt den Shebang generierter Konsolen-
    # Skripte nach sys.executable des AUFRUFENDEN Interpreters (nicht
    # nach dem Paket selbst) und installiert standardmaessig unter
    # sys.prefix -- direkt mit dem Wegwerf-venv aufgerufen laege beides
    # falsch (Shebang zeigt auf das gleich wieder verschwindende venv,
    # Dateien landen unter dessen absolutem Pfad statt /usr/...).
    # Deshalb System-python3 fuer den eigentlichen Install-Schritt,
    # "installer" nur per PYTHONPATH aus dem venv importiert.
    #
    # KORREKTUR eines fruehreren, falschen Kommentars hier ("empirisch...
    # ergibt korrekt /usr/bin/... und .../site-packages/"): das war
    # offenbar auf einem Nicht-Debian-System getestet (Arch nennt sein
    # Verzeichnis "site-packages", nie "dist-packages" -- ein echtes
    # Debian-System haette diesen Unterschied sofort gezeigt). Echt gegen
    # einen Debian-trixie-Container verifiziert (Anlass: astrapi-admin-
    # agent liess sich auf einem echten LXC nicht starten, obwohl das
    # .deb installiert war): Debians System-Python nutzt standardmaessig
    # das sysconfig-Schema "posix_local" -- installiert ohne Weiteres nach
    # /usr/local/bin bzw. /usr/local/lib/python3/dist-packages, NICHT nach
    # /usr/bin. DEB_PYTHON_INSTALL_LAYOUT=deb_system (das dh_python3/
    # pybuild intern setzen) erzwingt das korrekte Debian-Schema.
    export DEB_PYTHON_INSTALL_LAYOUT=deb_system
    _site="$(/tmp/build-venv/bin/python -c 'import sysconfig; print(sysconfig.get_path("purelib"))')"
    PYTHONPATH="$_site" python3 -m installer --destdir="${pkgdir}" dist/*.whl

    install -Dm644 packaging/systemd/astrapi-sync-cli.service \
        "${pkgdir}/usr/lib/systemd/user/astrapi-sync-cli.service"
}
