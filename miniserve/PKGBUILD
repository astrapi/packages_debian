# Maintainer: Michael Otto <michael@astrapi.de>
#
# Ersatz fuer filebrowser (T-012-DEBIAN): filebrowser wird am 2026-09-01
# archiviert (letzte Version v2.63.23, danach keine Releases/Security-
# Fixes mehr -- beim Funktionstest der filebrowser-Variante dieses
# Pakets live im Programmoutput aufgefallen). miniserve ist aktiv
# gepflegt, deutlich kleiner (nur Durchstoebern, kein Multi-User/DB-
# Unterbau) und deckt den eigentlichen Bedarf (Dateistruktur der
# paperless-ngx-Dokumente ansehen) genauso ab -- standardmaessig
# schreibgeschuetzt (Upload/Loeschen nur mit explizitem
# "--upload-files"-Flag, hier bewusst nicht gesetzt).
#
# pkgrel 2: Baut ab hier aus dem Quellcode statt des fertigen Release-
# Binarys -- eigenes "astrapi"-Farbschema (astrapi.scss) plus zwei
# kleine Patches an style.scss (Titel-/Suchzeile ausblenden, schlanke
# einfarbige Ordner-/Datei-Icons statt bunter Emoji) und renderer.rs
# (Theme in Rust-seitiger ThemeSlug-Enum + Picker-Liste registrieren).
# Farben 1:1 aus astrapi-hub/library/design-tokens.md uebernommen
# (Dark-Mode-Palette: --bg #101010, --text #f4f4f5, --b #2563eb als
# Akzent -- Akzentfarbe bewusst NICHT fuer Datei-/Ordner-Linktext
# verwendet, im echten astrapi-hub-UI sind Listeneintraege schlicht
# hell auf dunkler Karte, kein blauer Linktext). Kein fester Titel
# (MINISERVE_TITLE bewusst nicht gesetzt): das Paket soll sich auch
# fuer andere Verzeichnisse/Hosts wiederverwenden lassen, daher blendet
# astrapi.scss die ganze Titel-/Suchzeile aus statt sie zu befuellen.
#
# pkgrel 5: Bugfix, live auf dms.simpsons.lan aufgefallen -- die Icon-/
# Titel-/Suchzeilen-Anpassungen in style.scss waren an
# "body[data-theme=astrapi]" gebunden, dieses Attribut setzt miniserve
# aber ausschliesslich clientseitig per JS beim manuellen Klick im
# Theme-Umschalter. Der ist hier bewusst ausgeblendet
# (MINISERVE_HIDE_THEME_SELECTOR) -- das Overlay griff also nie, jetzt
# unconditional in style.scss. Zusaetzlich MINISERVE_COLOR_SCHEME_DARK
# ergaenzt (vorher nur COLOR_SCHEME gesetzt): ohne das gewinnt bei
# "prefers-color-scheme: dark" der Upstream-Default "archlinux" ueber
# unser astrapi, weil dessen @media-Block textuell nach unserem im
# generierten Stylesheet steht.
#
# pkgrel 6: Zweiter Kaskaden-Bug derselben Art, ebenfalls live auf
# dms.simpsons.lan aufgefallen -- die ".title-search-box { display:
# none }"-Regel aus pkgrel 5 stand VOR der eigentlichen Upstream-
# Definition ".title-search-box { display: flex; ... }" weiter unten in
# style.scss. Bei gleicher Spezifitaet gewinnt die zuletzt deklarierte
# Regel, die spaetere Upstream-Regel ueberschrieb unser "display: none"
# also wieder. Fix: kompletten Astrapi-Anpassungsblock ans Dateiende
# verschoben (nach der letzten Upstream-Regel), damit er garantiert
# zuletzt gewinnt.
#
# Braucht ein dediziertes Docker-Image (ctl/debian-builder-rust statt
# ctl/debian-builder, gleicher Grund wie bei vaultwarden/PKGBUILD):
# der Standard-Image hat kein cargo/rustc. miniserve selbst braucht
# keine System-Bibliotheken (reines Rust/rustls, kein OpenSSL-Binding),
# das groessere Rust-Image passt trotzdem, weil es schon im Repo
# gecacht ist.
#
# Laeuft als User "paperless" statt eines eigenen dedizierten
# System-Users: braucht Lesezugriff auf /opt/paperless/media/documents,
# das ausschliesslich paperless:paperless gehoert (siehe
# paperless-ngx/PKGBUILD postinst). depends=('paperless-ngx') stellt
# sicher, dass es diesen User und das Zielverzeichnis ueberhaupt gibt.
#
# Port 8080 uebernimmt die bisherige manuelle filebrowser-Installation
# auf dms.simpsons.lan (T-012-DEBIAN). Ab pkgrel 3 aber nur noch auf
# 127.0.0.1 gebunden statt auf die oeffentliche Adresse 172.19.19.4 --
# Caddy uebernimmt TLS + externen Zugriff auf Port 8443.
#
# pkgrel 4: fertige Caddy-Site-Datei (/etc/caddy/sites-enabled/
# miniserve.caddy) mitgeliefert statt nur einer Anleitung im postinst --
# gleiches Muster wie bookstack (E-008), auf Nutzerwunsch ("der
# bookstack-Weg ist der bessere") ab jetzt Konvention fuer alle Pakete,
# die hinter Caddy laufen. depends=('caddy') ergaenzt.
pkgname=miniserve
pkgver=0.35.0
pkgrel=6
pkgdesc="Minimalistischer, schreibgeschuetzter HTTP-Dateiserver (astrapi-Theme) -- hier als Werkzeug zum Durchstoebern der paperless-ngx-Dokumentenablage"
arch=('amd64')
distribution=trixie
url="https://github.com/svenstaro/miniserve"
license=('MIT')
depends=('paperless-ngx' 'caddy')
makedepends=('cargo' 'rustc') # Dokumentarisch -- kommen fest aus ctl/debian-builder-rust
source=('astrapi.scss' 'style.scss' 'renderer.rs')

_sha256="8ae108c161f2ed740f8c4b4dfd0a80805adcbaf7a05a6128f2b4d8f5093f5490"
_tarball="miniserve-${pkgver}.tar.gz"
_url="https://github.com/svenstaro/miniserve/archive/refs/tags/v${pkgver}.tar.gz"

build() {
    curl -fSL --retry 3 --retry-delay 2 -o "${_tarball}" "${_url}"
    echo "${_sha256}  ${_tarball}" | sha256sum -c -
    tar -xzf "${_tarball}"

    cd "${srcdir}/miniserve-${pkgver}"
    cp "${srcdir}/astrapi.scss" data/themes/astrapi.scss
    cp "${srcdir}/style.scss" data/style.scss
    cp "${srcdir}/renderer.rs" src/renderer.rs

    cargo build --release
}

package() {
    # Voller srcdir-Pfad statt eines relativen "cd": package() laeuft in
    # einer eigenen fakeroot-Subshell und darf sich nicht auf das cd aus
    # build() verlassen (siehe homepage/vaultwarden/paperless-ngx PKGBUILD).
    cd "${srcdir}/miniserve-${pkgver}"

    install -Dm755 "target/release/miniserve" "${pkgdir}/usr/bin/miniserve"

    install -Dm640 /dev/null "${pkgdir}/etc/miniserve.env"
    cat <<'EOF' > "${pkgdir}/etc/miniserve.env"
# miniserve Konfiguration fuer Debian
# Alle Flags aus "miniserve --help" sind hier als MINISERVE_<FLAG> setzbar
# (siehe [env: ...]-Angabe je Flag in der Hilfe).

MINISERVE_PATH=/opt/paperless/media/documents
MINISERVE_PORT=8080
# Nur lokal: Caddy uebernimmt TLS + oeffentlichen Zugriff (Port 8443,
# siehe /etc/caddy/Caddyfile auf dms.simpsons.lan) per reverse_proxy
# auf diesen Port -- gleiches Muster wie paperless-ngx auf Port 8000.
MINISERVE_INTERFACE=127.0.0.1

# "astrapi" ist ein eigenes, in dieses Paket gepatchtes Theme (siehe
# astrapi.scss) -- kein Upstream-Farbschema. COLOR_SCHEME_DARK
# zusaetzlich zu COLOR_SCHEME setzen: sonst greift bei
# "prefers-color-scheme: dark" (bei den meisten Browsern/Systemen
# Standard) der eigene Upstream-Default "archlinux" statt astrapi --
# beide Blöcke landen im selben Stylesheet, der Dark-Media-Query-Block
# steht dort textuell nach unserem und gewinnt sonst die Kaskade.
MINISERVE_COLOR_SCHEME=astrapi
MINISERVE_COLOR_SCHEME_DARK=astrapi
MINISERVE_DIRS_FIRST=true
MINISERVE_HIDE_VERSION_FOOTER=true
MINISERVE_HIDE_THEME_SELECTOR=true

# Optional: Basic-Auth aktivieren (Format user:password oder
# user:sha256:<hash>/user:sha512:<hash>), standardmaessig aus:
# MINISERVE_AUTH=user:password
EOF

    # Caddy-Site-Snippet (E-008-Muster von bookstack) -- TLS-
    # Zertifikatpfade nach dem auf dms.simpsons.lan bereits etablierten
    # Muster (/etc/caddy/simpsons.lan.crt/.key, siehe paperless-ngx-Block
    # in der Haupt-Caddyfile dort).
    install -Dm644 /dev/null "${pkgdir}/etc/caddy/sites-enabled/miniserve.caddy"
    cat <<'EOF' > "${pkgdir}/etc/caddy/sites-enabled/miniserve.caddy"
dms.simpsons.lan:8443 {
	tls /etc/caddy/simpsons.lan.crt /etc/caddy/simpsons.lan.key
	reverse_proxy 127.0.0.1:8080
}
EOF

    install -Dm644 /dev/null "${pkgdir}/usr/lib/systemd/system/miniserve.service"
    cat <<'EOF' > "${pkgdir}/usr/lib/systemd/system/miniserve.service"
[Unit]
Description=miniserve (Dokumentenablage von paperless-ngx durchstoebern)
Documentation=https://github.com/svenstaro/miniserve
After=network.target paperless-webserver.service

[Service]
User=paperless
Group=paperless
EnvironmentFile=/etc/miniserve.env
ExecStart=/usr/bin/miniserve
Restart=on-failure

[Install]
WantedBy=multi-user.target
EOF

    # .env + Caddy-Site-Datei als Conffiles: laesst dpkg eine vom Nutzer
    # angepasste Config (z.B. MINISERVE_AUTH, Domain/Port im Caddy-
    # Snippet) bei einem Upgrade unangetastet -- gleiche Konvention wie
    # paperless.conf/bookstack.
    install -d "${pkgdir}/DEBIAN"
    printf '/etc/miniserve.env\n/etc/caddy/sites-enabled/miniserve.caddy\n' \
        > "${pkgdir}/DEBIAN/conffiles"

    cat > "${pkgdir}/DEBIAN/postinst" << 'EOF'
#!/bin/sh
set -e
systemctl daemon-reload 2>/dev/null || true
systemctl reload caddy 2>/dev/null || true

cat <<'MSG'
miniserve installiert, aber noch nicht aktiv:
  1. Falls auf diesem Host bereits ein manuell gestarteter filebrowser-
     oder miniserve-Prozess auf Port 8080 laeuft: diesen zuerst beenden,
     sonst kollidiert das Paket beim Start mit "Address already in use".
  2. Konfiguration in /etc/miniserve.env pruefen (Pfad/Port/Interface,
     optional Basic-Auth via MINISERVE_AUTH).
  3. Dienst aktivieren:
     systemctl enable --now miniserve
  4. Caddy-Site-Datei /etc/caddy/sites-enabled/miniserve.caddy ist
     angelegt, aber noch NICHT automatisch aktiv -- in der Haupt-
     /etc/caddy/Caddyfile einmalig ergaenzen (falls noch nicht
     vorhanden):
       import /etc/caddy/sites-enabled/*.caddy
     Domain/Port/TLS-Zertifikatpfade im Snippet bei Bedarf anpassen,
     danach systemctl reload caddy
MSG
EOF
    chmod 755 "${pkgdir}/DEBIAN/postinst"

    cat > "${pkgdir}/DEBIAN/postrm" << 'EOF'
#!/bin/sh
set -e
systemctl daemon-reload 2>/dev/null || true
EOF
    chmod 755 "${pkgdir}/DEBIAN/postrm"
}

# vim:set ts=2 sw=2 et:
