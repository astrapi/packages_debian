# Maintainer: Michael Otto <michael@astrapi.de>
#
# pkgrel 2: liefert jetzt eine fertige Caddy-Site-Datei
# (/etc/caddy/sites-enabled/paperless-ngx.caddy) statt den Reverse-Proxy
# ausschliesslich Hand-editiert in der Haupt-Caddyfile zu pflegen --
# gleiches Muster wie bookstack (E-008) und miniserve, auf Nutzerwunsch
# jetzt Konvention fuer alle Pakete hinter Caddy. depends=('caddy')
# ergaenzt. Domain/Proxy-Ziel unveraendert vom bisherigen, Hand-
# gepflegten Block auf dms.simpsons.lan uebernommen.
#
# v3.0.5 (Kurskorrektur von E-003, das sich am 14.08. noch bewusst gegen
# v3.0.5 entschied): Breaking Changes einzeln anhand des offiziellen
# docs/migration-v3.md gegen die reale Config auf dms.simpsons.lan
# geprueft -- die meisten betreffen uns nicht oder nur harmlos, drei
# erfordern aber echtes Handeln (siehe naechster Kommentarblock).
#
# WICHTIG -- Upstream erlaubt laut docs/migration-v3.md ausdruecklich
# NUR ein Upgrade ab v2.20.15 ("Upgrading to Paperless-ngx v3 can only be
# performed from version 2.20.15"), nicht ab einer beliebigen 2.20.x-
# Version. Die zuvor deployte v2.20.5 (T-013-DEBIAN) muss deshalb VOR
# diesem Paket erst auf v2.20.15 aktualisiert werden (eigener,
# minimaler Zwischenschritt, bereits als eigener Commit vorbereitet,
# siehe Git-History -- v2.20.15 ist ein reines Sicherheits-/
# Bugfix-Release).
#
# Drei Punkte aus migration-v3.md, die auf dms.simpsons.lan tatsaechlich
# Handeln erfordern (nicht nur aus den PR-Titeln ableitbar, erst im
# ausfuehrlichen Guide gefunden):
#   1. PAPERLESS_DBENGINE ist jetzt Pflicht (vorher aus PAPERLESS_DBHOST
#      hergeleitet) -- unser Config-Template setzt das zwar bereits,
#      aber die ECHTE, per Conffile bewahrte Config auf dms.simpsons.lan
#      hat es nicht gesetzt (dort lief bisher v2, wo es optional war) --
#      muss beim Deploy manuell ergaenzt werden.
#   2. Volltextsuche-Migration (Whoosh->Tantivy): baut sich bei
#      Docker-Installationen automatisch beim Start neu auf, bei
#      bare-metal-Installationen (wie dieser hier) NICHT -- laut
#      Doku manuell noetig: "python3 manage.py document_index reindex
#      --if-needed" nach jedem Upgrade. In der postinst-Ausgabe unten
#      ergaenzt.
#   3. Reverse-Proxy-Login-Rate-Limiting (allauth-Client-IP-Ermittlung
#      geaendert) kann hinter einem Reverse-Proxy zu 403 Forbidden beim
#      Login fuehren -- betrifft uns, da dieses Paket ueblicherweise
#      hinter lokalem Caddy laeuft (siehe E-009). Deshalb
#      PAPERLESS_TRUSTED_PROXIES=127.0.0.1 neu im Config-Template aktiv
#      gesetzt (nicht nur als Kommentar), da praktisch jede Installation
#      dieses Pakets so reverse-proxied wird.
#
# Nebenfund beim tatsaechlichen Bau (nicht aus migration-v3.md ableitbar):
# das .deb waechst von ~224 MB auf ~553 MB. Grund: das neue "Paperless
# AI"-Feature (semantische Suche/Vorschlaege ueber Ollama/OpenAI) hat
# torch/transformers/sentence-transformers/llama-index-* etc. als
# **Kern**-Abhaengigkeiten in pyproject.toml eingetragen (nicht als
# optionale Extra wie z.B. "mariadb", also nicht per awk-Filter wie bei
# mysqlclient entfernbar, ohne das Startverhalten zu riskieren) --
# bewusst so belassen (Nutzerentscheidung), die KI-Features sind
# standardmaessig deaktiviert, nur der Plattenplatzbedarf steigt.
#
# Nutzt bewusst das offizielle Release-Tarball statt eines Git-Checkouts:
# enthaelt bereits ein fertig gebautes Frontend (static/, collectstatic
# bereits gelaufen) UND fertige systemd-Unit-Vorlagen (scripts/*.service) --
# kein Node/Angular-Build noetig, anders als bei homepage/PKGBUILD.
#
# Braucht ein dediziertes Docker-Image (ctl/debian-builder-python statt
# ctl/debian-builder, siehe E-003): "requirements.txt" pinnt
# psycopg-c==3.3.0, PyPI hat dafuer nur fuer cp312+x86_64/aarch64 ein
# eigenes (von paperless-ngx selbst gehostetes) Wheel -- unter Debian
# trixies python3 (3.13) baut pip das Paket also aus Quelltext, dafuer
# braucht es libpq-dev + einen Compiler. Alle anderen kompilier-verdaechtigen
# Abhaengigkeiten (pikepdf, lxml, numpy, pillow, cryptography, scikit-learn,
# zxing-cpp) haben bestaetigte cp313-Wheels auf PyPI.
#
# Config-Pfad /opt/paperless/paperless.conf statt /etc/paperless.conf
# (E-009): auf dms.simpsons.lan lief bereits eine bare-metal-Installation
# mit der Config genau dort. Zusaetzlicher Vorteil neben der reinen
# Pfadangleichung: als DEBIAN/conffiles-Eintrag markiert (siehe unten)
# laesst dpkg eine bei der Erstinstallation bereits vorhandene, nicht von
# dpkg verwaltete Datei an dieser Position unangetastet -- die echten
# DB-Zugangsdaten/den Secret-Key aus der bestehenden Installation
# automatisch bewahrt, kein manuelles Copy-Paste von Secrets noetig
# (gleicher Mechanismus wie bookstacks .env, siehe E-007).
pkgname=paperless-ngx
pkgver=3.0.5
pkgrel=2
pkgdesc="A community-supported supercharged document management system: scan, index and archive all your physical documents"
arch=('amd64')
distribution=trixie
url="https://docs.paperless-ngx.com"
license=('GPL-3.0-only')
depends=(
    # libzbar0 seit v3.0 nicht mehr noetig -- pyzbar-Barcode-Backend
    # entfernt (siehe Kommentar am Dateianfang), zxing-cpp (reine
    # Python-Abhaengigkeit im venv, kein System-Paket) ist jetzt der
    # einzige Backend.
    'python3'
    'redis-server'
    'postgresql'
    'tesseract-ocr'
    'tesseract-ocr-eng'
    'tesseract-ocr-deu'
    'tesseract-ocr-fra'
    'tesseract-ocr-ita'
    'tesseract-ocr-spa'
    'poppler-utils'
    'ghostscript'
    'qpdf'
    'unpaper'
    'liblept5'
    'libxml2'
    'pngquant'
    'zlib1g'
    'imagemagick'
    'fonts-liberation'
    'libmagic1'
    'gnupg'
    'caddy'
)
# Dokumentarisch -- jobs.py wertet makedepends nicht aus, kommen fest aus
# ctl/debian-builder-python (siehe E-003).
makedepends=('python3-venv' 'python3-dev' 'libpq-dev' 'pkg-config')
source=()

_sha256="d45500dfb4624e72913ecb12fe7d71c2d4d17abeb2406b65054bff728eda5bd1"
_tarball="paperless-ngx-v${pkgver}.tar.xz"
_url="https://github.com/paperless-ngx/paperless-ngx/releases/download/v${pkgver}/${_tarball}"

build() {
    curl -fSL --retry 3 --retry-delay 2 -o "${_tarball}" "${_url}"
    echo "${_sha256}  ${_tarball}" | sha256sum -c -
    tar -xJf "${_tarball}"

    cd "${srcdir}/paperless-ngx"

    # requirements.txt wurde mit "uv export --all-extras" erzeugt und enthaelt
    # deshalb auch die optionale "mariadb"-Extra (einziger Extra-Block in
    # pyproject.toml: mysqlclient~=2.2.7). Wir nutzen PostgreSQL, nicht
    # MariaDB -- mysqlclient braucht zum Bauen aus Quelltext
    # libmariadb-dev/default-libmysqlclient-dev, das das Image nicht hat
    # (verifiziert: pip bricht sonst mit "Can not find valid pkg-config name"
    # ab). Statt das Image dafuer aufzublasen, wird der ungenutzte Block
    # rausgefiltert -- awk statt sed, weil der Eintrag ueber drei Zeilen geht
    # (Paketzeile + --hash-Zeile + "# via"-Kommentar).
    awk '
        $0 ~ /^[^[:space:]]/ { skip = ($0 ~ /^mysqlclient==/) ? 1 : 0 }
        !skip { print }
    ' requirements.txt > requirements.postgres.txt

    python3 -m venv "${srcdir}/venv"
    "${srcdir}/venv/bin/pip" install --upgrade pip
    # requirements.postgres.txt enthaelt --hash=sha256:... fuer jede
    # Abhaengigkeit (von "uv export" erzeugt) -- pip verifiziert das
    # automatisch.
    "${srcdir}/venv/bin/pip" install -r requirements.postgres.txt

    # Ein venv ist nicht von Haus aus umzugsfaehig: pip schreibt in jedes
    # Console-Script (celery, granian, pip, ...) eine feste Shebang-Zeile
    # mit dem absoluten Erzeugungspfad (hier "${srcdir}/venv/bin/python3",
    # also z.B. /build/src/paperless-ngx/venv/bin/python3) -- verifiziert:
    # ohne diesen Fix scheitert jeder Start mit "No such file or directory",
    # weil der Kernel den Interpreter aus der Shebang-Zeile sucht, und der
    # existiert am Zielsystem (/opt/paperless/venv) nicht. Deshalb auf den
    # tatsaechlichen Installationspfad umschreiben, bevor package() das venv
    # dorthin kopiert.
    for f in "${srcdir}/venv/bin/"*; do
        [[ -f "$f" ]] || continue
        head -1 "$f" | grep -q "^#!${srcdir}/venv/bin/python3" || continue
        sed -i "1s|^#!.*|#!/opt/paperless/venv/bin/python3|" "$f"
    done

    # NLTK-Sprachdaten fuer die Volltextsuche, gleiche drei Pakete wie im
    # offiziellen Dockerfile (Zeile "Installing NLTK data").
    #
    # NLTK_DATA muss zusaetzlich zu "-d" gesetzt werden: das pinnte
    # nltk==3.10.0 (siehe requirements.txt) hat einen neuen
    # I/O-Sicherheits-Sentinel (nltk/pathsec.py, ENFORCE=True per Default)
    # bekommen, der Downloads nur noch in eine feste Allowlist erlaubt
    # (~/nltk_data, /usr/share/nltk_data, System-Tempdir, oder was in
    # nltk.data.path/NLTK_DATA steht) -- "-d" allein legt zwar das
    # Download-Verzeichnis fest, macht es aber NICHT automatisch zu einer
    # erlaubten Wurzel. Lokal reproduziert: identischer Aufruf unter /tmp
    # (im System-Tempdir, also implizit erlaubt) funktioniert anstandslos,
    # derselbe Aufruf mit einem srcdir ausserhalb von /tmp (wie im echten
    # Build-Container, "/build/src/...") scheitert exakt mit der
    # gemeldeten "Security Violation [Downloader._download_package]:
    # Unauthorized path"-Fehlermeldung. Mit NLTK_DATA=dasselbe
    # Zielverzeichnis wird es Teil der Allowlist, Downloads laufen durch.
    NLTK_DATA="${srcdir}/nltk_data" "${srcdir}/venv/bin/python3" \
        -W ignore::RuntimeWarning -m nltk.downloader \
        -d "${srcdir}/nltk_data" snowball_data stopwords punkt_tab
}

package() {
    # Voller srcdir-Pfad statt eines relativen "cd": package() laeuft in
    # einer eigenen fakeroot-Subshell und darf sich nicht auf das cd aus
    # build() verlassen (siehe homepage/vaultwarden PKGBUILD).
    cd "${srcdir}/paperless-ngx"

    install -d "${pkgdir}/opt/paperless"
    cp -r src "${pkgdir}/opt/paperless/src"
    cp -r static "${pkgdir}/opt/paperless/static"
    cp -r "${srcdir}/venv" "${pkgdir}/opt/paperless/venv"

    install -d "${pkgdir}/usr/share/nltk_data"
    cp -r "${srcdir}/nltk_data/." "${pkgdir}/usr/share/nltk_data/"

    # MEDIA_ROOT/DATA_DIR/STATIC_ROOT/CONSUMPTION_DIR muessen NICHT gesetzt
    # werden: paperless-ngx' settings.py defaulted sie auf
    # BASE_DIR.parent/{media,data,static,consume} -- bei
    # WorkingDirectory=/opt/paperless/src trifft das von selbst genau unser
    # Layout.
    install -Dm640 /dev/null "${pkgdir}/opt/paperless/paperless.conf"
    cat <<'EOF' > "${pkgdir}/opt/paperless/paperless.conf"
# paperless-ngx Konfiguration fuer Debian
# Volle Optionsliste: https://docs.paperless-ngx.com/configuration/

PAPERLESS_REDIS=redis://localhost:6379
PAPERLESS_DBENGINE=postgresql
PAPERLESS_DBHOST=localhost
PAPERLESS_DBNAME=paperless
PAPERLESS_DBUSER=paperless
PAPERLESS_DBPASS=change-me

# Wird von postinst automatisch durch einen echten Zufallswert ersetzt,
# solange hier noch "change-me" steht.
PAPERLESS_SECRET_KEY=change-me

PAPERLESS_TIME_ZONE=Europe/Berlin
PAPERLESS_OCR_LANGUAGE=deu
PAPERLESS_OCR_LANGUAGES=eng fra ita spa

# Reverse-Proxy-Login-Rate-Limiting (allauth) seit v3 auf explizite
# Trusted-Proxy-Liste umgestellt, sonst drohen 403 Forbidden beim Login
# hinter einem Reverse-Proxy. Dieses Paket wird ueblicherweise hinter
# lokalem Caddy betrieben (siehe E-009) -- deshalb aktiv statt nur als
# Kommentar. Bei abweichendem Setup (kein lokaler Reverse-Proxy)
# entfernen.
PAPERLESS_TRUSTED_PROXIES=127.0.0.1

# PAPERLESS_URL=https://paperless.example.com
EOF

    # systemd-Units: aus den Vorlagen im Release-Tarball (scripts/*.service)
    # uebernommen, aber ExecStart auf das vendorte venv umgebogen (statt
    # nacktes System-python3/celery), EnvironmentFile ergaenzt, und
    # "Requires=redis.service" -> "Requires=redis-server.service" (der
    # tatsaechliche Debian-Unit-Name, redis.service existiert dort nicht).
    #
    # Liegen bewusst unter /usr/lib/systemd/system/ (Paket-verwaltet) statt
    # /etc/systemd/system/ -- Vorsicht bei einer Migration ueber eine
    # bestehende manuelle Installation: systemd bevorzugt gleichnamige
    # Units unter /etc/systemd/system/, die dort ggf. noch von der alten
    # Installation liegen, gegenueber unseren hier (gleiches Problem wie
    # bei homepage, siehe T-009-DEBIAN) -- die alten Dateien muessen vor
    # dem Aktivieren entfernt werden, sonst greifen unsere Units nie.
    install -d "${pkgdir}/usr/lib/systemd/system"

    install -Dm644 /dev/null "${pkgdir}/usr/lib/systemd/system/paperless-webserver.service"
    cat <<'EOF' > "${pkgdir}/usr/lib/systemd/system/paperless-webserver.service"
[Unit]
Description=Paperless webserver
After=network.target
Wants=network.target
Requires=redis-server.service
#Requires=paperless-webserver.socket

[Service]
User=paperless
Group=paperless
WorkingDirectory=/opt/paperless/src
EnvironmentFile=/opt/paperless/paperless.conf

Environment=GRANIAN_HOST=::
Environment=GRANIAN_PORT=8000
Environment=GRANIAN_WORKERS=1

ExecStart=/bin/sh -c '\
  [ -n "$PAPERLESS_BIND_ADDR" ] && export GRANIAN_HOST=$PAPERLESS_BIND_ADDR; \
  [ -n "$PAPERLESS_PORT" ] && export GRANIAN_PORT=$PAPERLESS_PORT; \
  [ -n "$PAPERLESS_WEBSERVER_WORKERS" ] && export GRANIAN_WORKERS=$PAPERLESS_WEBSERVER_WORKERS; \
  [ -n "$PAPERLESS_FORCE_SCRIPT_NAME" ] && export GRANIAN_URL_PATH_PREFIX=$PAPERLESS_FORCE_SCRIPT_NAME; \
  exec /opt/paperless/venv/bin/granian --interface asginl --ws --loop uvloop "paperless.asgi:application"'
Restart=on-failure

[Install]
WantedBy=multi-user.target
EOF
    chmod 644 "${pkgdir}/usr/lib/systemd/system/paperless-webserver.service"

    install -Dm644 /dev/null "${pkgdir}/usr/lib/systemd/system/paperless-webserver.socket"
    cat <<'EOF' > "${pkgdir}/usr/lib/systemd/system/paperless-webserver.socket"
[Unit]
Description=Paperless Webserver Socket

[Socket]
ListenStream=8000
NoDelay=true

[Install]
WantedBy=sockets.target
EOF
    chmod 644 "${pkgdir}/usr/lib/systemd/system/paperless-webserver.socket"

    install -Dm644 /dev/null "${pkgdir}/usr/lib/systemd/system/paperless-consumer.service"
    cat <<'EOF' > "${pkgdir}/usr/lib/systemd/system/paperless-consumer.service"
[Unit]
Description=Paperless consumer
Requires=redis-server.service

[Service]
User=paperless
Group=paperless
WorkingDirectory=/opt/paperless/src
EnvironmentFile=/opt/paperless/paperless.conf
ExecStart=/opt/paperless/venv/bin/python3 manage.py document_consumer
Restart=on-failure

[Install]
WantedBy=multi-user.target
EOF
    chmod 644 "${pkgdir}/usr/lib/systemd/system/paperless-consumer.service"

    install -Dm644 /dev/null "${pkgdir}/usr/lib/systemd/system/paperless-task-queue.service"
    cat <<'EOF' > "${pkgdir}/usr/lib/systemd/system/paperless-task-queue.service"
[Unit]
Description=Paperless Celery Workers
Requires=redis-server.service

[Service]
User=paperless
Group=paperless
WorkingDirectory=/opt/paperless/src
EnvironmentFile=/opt/paperless/paperless.conf
ExecStart=/opt/paperless/venv/bin/celery --app paperless worker --loglevel INFO
Restart=on-failure

[Install]
WantedBy=multi-user.target
EOF
    chmod 644 "${pkgdir}/usr/lib/systemd/system/paperless-task-queue.service"

    install -Dm644 /dev/null "${pkgdir}/usr/lib/systemd/system/paperless-scheduler.service"
    cat <<'EOF' > "${pkgdir}/usr/lib/systemd/system/paperless-scheduler.service"
[Unit]
Description=Paperless Celery Beat
Requires=redis-server.service

[Service]
User=paperless
Group=paperless
WorkingDirectory=/opt/paperless/src
EnvironmentFile=/opt/paperless/paperless.conf
ExecStart=/opt/paperless/venv/bin/celery --app paperless beat --loglevel INFO
Restart=on-failure

[Install]
WantedBy=multi-user.target
EOF
    chmod 644 "${pkgdir}/usr/lib/systemd/system/paperless-scheduler.service"

    # Caddy-Site-Snippet (gleiches Muster wie bookstack/E-008 und
    # miniserve): bisher lief der Reverse-Proxy fuer dieses Paket als
    # Hand-editierter Block direkt in der Haupt-/etc/caddy/Caddyfile auf
    # dms.simpsons.lan -- jetzt als eigene, paketverwaltete Datei unter
    # sites-enabled/. Domain/TLS-Zertifikatpfad unveraendert vom
    # bestehenden Block uebernommen.
    install -Dm644 /dev/null "${pkgdir}/etc/caddy/sites-enabled/paperless-ngx.caddy"
    cat <<'EOF' > "${pkgdir}/etc/caddy/sites-enabled/paperless-ngx.caddy"
dms.simpsons.lan {
	reverse_proxy 127.0.0.1:8000
	tls /etc/caddy/simpsons.lan.crt /etc/caddy/simpsons.lan.key
}
EOF

    # Dedizierter System-User + Daten-/Medienverzeichnisse -- gleiches Muster
    # wie vaultwarden/homepage. PAPERLESS_SECRET_KEY wird beim ersten
    # Postinst-Lauf generiert, solange noch der Platzhalter drinsteht (auch
    # bei einem Reinstall/Upgrade idempotent, ueberschreibt keinen bereits
    # gesetzten echten Wert).
    install -d "${pkgdir}/DEBIAN"

    # paperless.conf + Caddy-Site-Datei als Conffiles: laesst dpkg eine bei
    # der Erstinstallation bereits vorhandene, nicht von dpkg verwaltete
    # Datei an dieser Position unangetastet (siehe Kommentar am
    # Dateianfang) -- kritisch fuer die Migration von der bare-metal-
    # Installation, deren echte Config sonst durch den Platzhalter oben
    # ueberschrieben wuerde. Fuer sites-enabled/paperless-ngx.caddy gibt es
    # (noch) keine vorherige, dpkg-fremde Datei an genau diesem Pfad --
    # trotzdem als Conffile markiert, damit spaetere lokale Anpassungen bei
    # einem Upgrade nicht stillschweigend ueberschrieben werden.
    printf '/opt/paperless/paperless.conf\n/etc/caddy/sites-enabled/paperless-ngx.caddy\n' \
        > "${pkgdir}/DEBIAN/conffiles"

    cat > "${pkgdir}/DEBIAN/postinst" << 'EOF'
#!/bin/sh
set -e
if ! getent passwd paperless >/dev/null; then
    adduser --system --group --no-create-home --home /opt/paperless \
        --shell /usr/sbin/nologin paperless
fi
install -d -o paperless -g paperless /opt/paperless/media
install -d -o paperless -g paperless /opt/paperless/data
install -d -o paperless -g paperless /opt/paperless/consume
install -d -o paperless -g paperless /opt/paperless/export

chown paperless:paperless /opt/paperless/paperless.conf
chmod 640 /opt/paperless/paperless.conf

if grep -q '^PAPERLESS_SECRET_KEY=change-me$' /opt/paperless/paperless.conf; then
    _key=$(head -c 48 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 64)
    sed -i "s/^PAPERLESS_SECRET_KEY=change-me\$/PAPERLESS_SECRET_KEY=${_key}/" /opt/paperless/paperless.conf
fi

# systemd merkt jeden dpkg-Schreibvorgang auf die Unit-Dateien als
# "changed on disk" (auch bei inhaltlich identischem Neuschreiben) und
# verweigert sonst den naechsten restart/enable mit einer Warnung, bis
# manuell "daemon-reload" ausgefuehrt wird -- Standard-Praxis bei
# Debian-Paketen mit eigenen Units, deshalb automatisiert statt als
# manueller Schritt fuer den Nutzer.
systemctl daemon-reload 2>/dev/null || true
systemctl reload caddy 2>/dev/null || true

cat <<'MSG'
paperless-ngx installiert, aber noch nicht startklar:
  1. Falls dies eine frische Installation ist (keine bestehende Config
     uebernommen): /opt/paperless/paperless.conf ausfuellen (mindestens
     PAPERLESS_DBPASS)
  2. Falls von v2.x migriert: PAPERLESS_DBENGINE=postgresql (oder
     mariadb) in /opt/paperless/paperless.conf pruefen/ergaenzen --
     seit v3 Pflicht, vorher aus PAPERLESS_DBHOST hergeleitet und in
     aelteren Configs oft nicht gesetzt
  3. PostgreSQL-Rolle + Datenbank anlegen (Name/User/Passwort aus
     /opt/paperless/paperless.conf), falls noch nicht vorhanden
  4. Erstes Migrate:
     sudo -u paperless /opt/paperless/venv/bin/python3 \
       /opt/paperless/src/manage.py migrate
  5. Volltextsuche-Index (Whoosh->Tantivy seit v3, baut sich bei
     bare-metal-Installationen wie dieser NICHT automatisch neu auf):
     sudo -u paperless /opt/paperless/venv/bin/python3 \
       /opt/paperless/src/manage.py document_index reindex --if-needed
  6. Falls von einer manuellen Installation migriert: alte, gleichnamige
     Units unter /etc/systemd/system/paperless-*.service pruefen und bei
     Bedarf entfernen (die haben Vorrang vor unseren unter
     /usr/lib/systemd/system/) -- dann "systemctl daemon-reload"
  7. Dienste aktivieren:
     systemctl enable --now paperless-webserver paperless-consumer \
       paperless-task-queue paperless-scheduler
  8. Caddy-Site-Datei /etc/caddy/sites-enabled/paperless-ngx.caddy ist
     angelegt, aber noch NICHT automatisch aktiv -- in der Haupt-
     /etc/caddy/Caddyfile einmalig ergaenzen (falls noch nicht
     vorhanden):
       import /etc/caddy/sites-enabled/*.caddy
     WICHTIG bei Migration von einer Hand-editierten Haupt-Caddyfile:
     einen dort ggf. schon vorhandenen "dms.simpsons.lan { ... }"-Block
     VORHER entfernen, sonst kollidieren zwei Site-Definitionen fuer
     denselben Host. Danach systemctl reload caddy
MSG
EOF
    chmod 755 "${pkgdir}/DEBIAN/postinst"

    cat > "${pkgdir}/DEBIAN/postrm" << 'EOF'
#!/bin/sh
set -e
if [ "$1" = "purge" ]; then
    deluser --system paperless >/dev/null 2>&1 || true
    rm -rf /opt/paperless/media /opt/paperless/data /opt/paperless/consume /opt/paperless/export
fi
EOF
    chmod 755 "${pkgdir}/DEBIAN/postrm"
}

# vim:set ts=2 sw=2 et:
