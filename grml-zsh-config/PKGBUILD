# Maintainer: astrapi <astrapi@example.com>
# Upstream:   Pierre Schmitz <pierre@archlinux.de>
#
# pkgrel 2: erster Versuch, "replaces=('zsh-common')" ergaenzt --
# wirkungslos, die Build-Pipeline (jobs.py) uebersetzt dieses Feld fuer
# Debian-Pakete nicht (nur Arch-Pakete in diesem Repo nutzen es bisher,
# per "dpkg-deb -I" verifiziert: kein "Replaces:" im generierten
# control). Deshalb entfernt, siehe pkgrel 3.
#
# pkgrel 3: eigentlicher Fix, auf streaming.simpsons.lan aufgefallen --
# dpkg lehnte den Install ab ("trying to overwrite '/etc/zsh/zshrc',
# which is also in package zsh-common"), dort ein echtes Conffile von
# zsh-common. Da die Pipeline kein "Replaces:"-Feld setzt, stattdessen
# der klassische Debian-Mechanismus komplett ueber Maintainer-Skripte:
# "dpkg-divert" in preinst/postrm (siehe Kommentare dort) -- braucht
# keine besondere Control-Datei-Unterstuetzung durch die Pipeline, nur
# normale preinst/postrm-Skripte, die die Pipeline nachweislich
# unveraendert uebernimmt (wie bei jedem anderen Paket hier).
pkgname=grml-zsh-config
pkgver=0.20.1
pkgrel=1
pkgdesc="grml's zsh setup"
arch=('all')
distribution=trixie
url='https://grml.org/zsh/'
license=('GPL-2')
depends=('zsh' 'coreutils' 'grep' 'sed' 'procps')
makedepends=('curl')
source=()

_sha256="79a1cba5a7232ff14b03a3ce9aeb8d42e060a0c3f6387ca799574b37b6fc400c"
_tarball="grml-etc-core-${pkgver}.tar.gz"
_url="https://github.com/grml/grml-etc-core/archive/refs/tags/v${pkgver}.tar.gz"

package() {
    # Quelle herunterladen und prüfen
    curl -fSL -o "/tmp/${_tarball}" "${_url}"
    echo "${_sha256}  /tmp/${_tarball}" | sha256sum -c -

    tar -xzf "/tmp/${_tarball}" -C /tmp/

    cd "/tmp/grml-etc-core-${pkgver}"

    install -D -m644 etc/skel/.zshrc  "${pkgdir}/etc/skel/.zshrc"
    install -D -m644 etc/zsh/keephack "${pkgdir}/etc/zsh/keephack"
    install -D -m644 etc/zsh/zshrc    "${pkgdir}/etc/zsh/zshrc"

    install -dm755 "${pkgdir}/usr/share/doc/${pkgname}"
    cat > "${pkgdir}/usr/share/doc/${pkgname}/copyright" << 'EOF'
Format: https://www.debian.org/doc/packaging-manuals/copyright-format/1.0/
Upstream-Name: grml-etc-core
Upstream-Contact: Michael Prokop <mika@grml.org>
Source: https://github.com/grml/grml-etc-core

License: GPL-2
 This program is free software; you can redistribute it and/or modify
 it under the terms of the GNU General Public License as published by
 the Free Software Foundation; version 2 of the License.
 .
 On Debian systems, the full text of the GNU General Public License
 version 2 can be found in /usr/share/common-licenses/GPL-2.
EOF

    # dpkg-divert statt "Replaces:" (siehe Kommentar am Dateianfang):
    # lenkt /etc/zsh/zshrc VOR dem eigentlichen Unpack aus dem Weg, damit
    # zsh-commons Anspruch auf den Pfad nicht mehr kollidiert -- unser
    # eigenes Paket ist von der Umlenkung ausgenommen ("--package"),
    # bekommt den echten Pfad also trotzdem.
    install -d "${pkgdir}/DEBIAN"
    cat > "${pkgdir}/DEBIAN/preinst" << 'EOF'
#!/bin/sh
set -e
dpkg-divert --package grml-zsh-config --add --rename \
    --divert /etc/zsh/zshrc.zsh-common /etc/zsh/zshrc
EOF
    chmod 755 "${pkgdir}/DEBIAN/preinst"

    cat > "${pkgdir}/DEBIAN/postrm" << 'EOF'
#!/bin/sh
set -e
# dpkg ruft postrm bei "purge" zweimal mit unterschiedlichem $1 auf
# ("remove", dann spaeter "purge") -- die Umlenkung nur beim ersten Mal
# aufheben, sonst meldet dpkg-divert beim zweiten Aufruf harmlos aber
# unnoetig "none removed".
if [ "$1" = "remove" ]; then
    dpkg-divert --package grml-zsh-config --remove --rename \
        --divert /etc/zsh/zshrc.zsh-common /etc/zsh/zshrc
fi
EOF
    chmod 755 "${pkgdir}/DEBIAN/postrm"
}
