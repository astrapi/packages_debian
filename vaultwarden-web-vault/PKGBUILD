# Maintainer: Michael Otto <michael@astrapi.de>
pkgname=vaultwarden-web-vault
pkgver=2026.7.0
pkgrel=1
pkgdesc="Web vault frontend for vaultwarden server"
arch=('all')
distribution=trixie
depends=()
makedepends=('curl')
source=()

_sha256="002e972bf0d0487ec0324b06d916de33e29de4c29bffd92ee3b843084c300570"
_tarball="bw_web_v${pkgver}.tar.gz"
_url="https://github.com/dani-garcia/bw_web_builds/releases/download/v${pkgver}/${_tarball}"

package() {
    curl -fSL -o "/tmp/${_tarball}" "${_url}"
    echo "${_sha256}  /tmp/${_tarball}" | sha256sum -c -

    tar -xzf "/tmp/${_tarball}" -C /tmp/

    install -dm755 "$pkgdir/usr/share/vaultwarden"
    cp -r /tmp/web-vault "$pkgdir/usr/share/vaultwarden/web-vault"
}
